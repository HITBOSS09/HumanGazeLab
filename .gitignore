.venv/
__pycache__/
**/__pycache__/
.pytest_cache/
.mypy_cache/
*.py[cod]
*.egg-info/
.DS_Store

# Original dataset and local extracts. Hashes and counts are recorded under outputs/.
data/raw/*
!data/raw/.gitkeep
data/interim/*
!data/interim/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Scanpath-level table is regenerated by scripts/run_analysis.py and is too large to version.
outputs/tables/scanpath_level.csv

# Per-image event files are the resume cache.
outputs/semantic_calibration_v1/events/
# The concatenated event table is 139 MB and is rejected by the 100 MB limit.
# The same rows are versioned as one CSV per label under region_events/.
outputs/semantic_calibration_v1/region_events.csv
outputs/semantic_spatial_v1/events/
*.zip
